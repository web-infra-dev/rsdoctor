{
  "name": "rsdoctor-monorepo",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "pnpm --workspace-concurrency=10 --filter \"./packages/*\" --filter \"!./packages/document\" --filter \"./scripts/*\" run build",
    "check": "rs check",
    "check-dependency-version": "pnpx check-dependency-version-consistency . && echo",
    "check-spell": "pnpx cspell",
    "dev:doc": "cd packages/document && pnpm run dev",
    "e2e": "pnpm run e2e:base",
    "e2e:base": "cd ./e2e && cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm test",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "pnpm run build && rs hooks",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm --workspace-concurrency=1 --filter \"./packages/*\" test",
    "test:all": "pnpm run test && pnpm run e2e"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@scripts/config": "workspace:*",
    "@scripts/test-helper": "workspace:*",
    "cross-env": "catalog:",
    "cspell-ban-words": "^0.0.4",
    "heading-case": "^2.0.1",
    "pkg-pr-new": "0.0.88",
    "rstack": "^0.6.5"
  },
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.0.0"
  }
}
