{
  "extends": "@rsdoctor/tsconfig/base",
  "compilerOptions": {
    "allowJs": false,
    "experimentalDecorators": true,
    "isolatedDeclarations": true,
    "outDir": "./dist",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["**/node_modules"]
}
