{
  "extends": "@rsdoctor/tsconfig/base",
  "compilerOptions": {
    "experimentalDecorators": true,
    "outDir": "./dist",
    "types": ["node"],
    "paths": {
      "@rsdoctor/core": ["../core/src/index.ts"],
      "@/*": ["./src/*"]
    },
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["**/node_modules"],
  "references": [
    {
      "path": "../shared/tsconfig.json"
    },
    {
      "path": "../core/tsconfig.json"
    }
  ]
}
